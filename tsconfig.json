{
  "compilerOptions": {
    "allowJs": true,
    "noImplicitAny": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/integrations/supabase/client": [
        "./src/types/supabase-client-loose"
      ],
      "@/integrations/supabase/types": [
        "./src/types/supabase-types-loose"
      ],
      "@/*": [
        "./src/*"
      ],
      "gl-matrix": [
        "./src/types/gl-matrix-shim"
      ],
      "mapbox-gl": [
        "./src/types/mapbox-gl-shim"
      ]
    },
    "skipLibCheck": true,
    "strictNullChecks": false
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.node.json"
    }
  ]
}